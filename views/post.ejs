<%- include('partials/header', { title: post.title }) %>
<article class="post">
  <h1><%= post.title %></h1>
  <p class="meta">by <%= post.author %> on <%= post.created_at %></p>
  <div class="post-body"><%= post.body %></div>
  <% if (currentUser && currentUser.role === 'admin') { %>
    <form method="POST" action="/posts/<%= post.id %>/delete">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit">Delete post</button>
    </form>
  <% } %>
</article>
<section class="comments">
  <h2>Comments</h2>
  <% if (comments.length === 0) { %>
    <p>No comments yet.</p>
  <% } else { %>
    <% comments.forEach(function (comment) { %>
      <div class="comment">
        <p class="meta"><%= comment.author %> on <%= comment.created_at %></p>
        <%# [FIX-XSS-S] Report Secure-3 | OWASP A03 + XSS Prevention Cheat Sheet | CWE-79 | closes #3 %>
        <%# WHY: the stored comment is printed with the escaped output tag. Any markup, such as %>
        <%#      script tags, event handlers or svg, is shown as plain text to every viewer. %>
        <%# RESIDUAL: this encoding is right for the HTML body. If a comment were put into an %>
        <%#           attribute or into a script, that place needs its own encoding. CSP backs it up. %>
        <p class="comment-body"><%= comment.body %></p>
      </div>
    <% }) %>
  <% } %>

  <% if (currentUser) { %>
    <form method="POST" action="/posts/<%= post.id %>/comments">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label for="body">Add a comment</label>
      <textarea id="body" name="body" required></textarea>
      <button type="submit">Comment</button>
    </form>
  <% } else { %>
    <p><a href="/login">Log in</a> to comment.</p>
  <% } %>
</section>

<p><a href="/">&larr; Back to posts</a></p>
<%- include('partials/footer') %>
