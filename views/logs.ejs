<%- include('partials/header', { title: 'Logs' }) %>
<h1>Event log</h1>

<% if (logs.length === 0) { %>
  <p>No events logged yet.</p>
<% } else { %>
  <table>
    <thead>
      <tr><th>Time</th><th>Level</th><th>Event</th><th>User</th><th>IP</th></tr>
    </thead>
    <tbody>
      <% logs.forEach(function (log) { %>
        <tr>
          <td><%= log.created_at %></td>
          <td><%= log.level %></td>
          <td><%= log.event %></td>
          <td><%= log.username || '-' %></td>
          <td><%= log.ip || '-' %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>
<%- include('partials/footer') %>
