<%- include('partials/header', { title: 'Search' }) %>
<h1>Search posts</h1>

<form method="GET" action="/search">
  <label for="q">Search term</label>
  <input type="search" id="q" name="q" value="<%= q %>">
  <button type="submit">Search</button>
</form>

<%# Populated on the client by /js/search.js — see the DOM-based XSS sink there. %>
<div id="results"></div>

<% if (q) { %>
  <%# [VULN-XSS-R] OWASP A03:2021 | CWE-79 | Report Insecure-2 | Issue #2 %>
  <%# WHY: q is rendered unescaped (raw), so a script payload in the search term is %>
  <%#      reflected as live markup and executes in the browser. %>
  <p>You searched for: <%- q %></p>
  <% if (results.length === 0) { %>
    <p>No posts matched your search.</p>
  <% } else { %>
    <ul class="post-list">
      <% results.forEach(function (post) { %>
        <li>
          <h2><a href="/posts/<%= post.id %>"><%= post.title %></a></h2>
          <p class="meta">by <%= post.author %> on <%= post.created_at %></p>
        </li>
      <% }) %>
    </ul>
  <% } %>
<% } %>
<script src="/js/search.js"></script>
<%- include('partials/footer') %>
