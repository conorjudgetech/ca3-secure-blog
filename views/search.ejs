<%- include('partials/header', { title: 'Search' }) %>
<h1>Search posts</h1>

<form method="GET" action="/search">
  <label for="q">Search term</label>
  <input type="search" id="q" name="q" value="<%= q %>">
  <button type="submit">Search</button>
</form>

<%# Populated on the client by /js/search.js using textContent (see [FIX-XSS-D]). %>
<div id="results"></div>

<% if (q) { %>
  <%# [FIX-XSS-R] OWASP A03 + XSS Prevention Cheat Sheet | CWE-79 | Report Secure-2 | closes #2 %>
  <%# WHY: q is rendered with the escaped output tag, which HTML-entity-encodes it, so a %>
  <%#      script payload in the search term is shown as inert text, not parsed as markup. %>
  <%# RESIDUAL: encoding is correct for this HTML body context; a value placed into an %>
  <%#           attribute, URL or JS context needs that context's encoding. CSP backs it up. %>
  <p>You searched for: <%= q %></p>
  <% if (results.length === 0) { %>
    <p>No posts matched your search.</p>
  <% } else { %>
    <ul class="post-list">
      <% results.forEach(function (post) { %>
        <li>
          <h2><a href="/posts/<%= post.id %>"><%= post.title %></a></h2>
          <p class="meta">by <%= post.author %> on <%= post.created_at %></p>
        </li>
      <% }) %>
    </ul>
  <% } %>
<% } %>
<script src="/js/search.js"></script>
<%- include('partials/footer') %>
