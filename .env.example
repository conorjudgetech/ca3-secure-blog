# Copy this file to .env and adjust the values for your environment.
# .env is gitignored and must never be committed.

# Port the HTTP server listens on
PORT=3000

# Secret used to sign the session cookie. Use a long random string in any real deployment.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Path to the SQLite database file (relative to the project root)
DB_PATH=data/blog.db

# bcrypt cost factor used when hashing passwords
BCRYPT_ROUNDS=12
